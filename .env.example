# ==============================================================================
# SentinelMesh Production & Development Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Database Configuration (Defaults to persistent SQLite; PostgreSQL fully supported)
# SENTINEL_DATABASE_URL=sqlite:///data/sentinelmesh.db
# DATABASE_URL=postgresql://postgres:password@postgres.render.com:5432/sentinelmesh

# Storage & File Path Configuration
DATA_DIR=data

# Pluggable LLM API Keys (Optional - SentinelMesh runs 100% offline with zero external keys by default)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Frontend Decoupled Deployment (Optional - ONLY needed if hosting frontend separately on Vercel)
# VITE_API_URL=https://your-sentinelmesh.onrender.com
# VITE_WS_URL=wss://your-sentinelmesh.onrender.com
